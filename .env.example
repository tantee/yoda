# Placeholders / dev values only. Copy to .env (git-ignored). Never commit real secrets.
# Production secrets come from the deploy environment, not from files.

# dev compose host ports (bound to 127.0.0.1; override if taken)
POSTGRES_PORT=5432
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001
KEYCLOAK_PORT=8080

# prod compose host ports
CORE_PORT=4000

# core
PORT=4000
DATABASE_URL=postgres://yoda:yoda@localhost:5432/yoda
TEST_DATABASE_URL=postgres://yoda:yoda@localhost:5432/yoda_test
# Must match KEYCLOAK_PORT if you override it (e.g. http://localhost:18080/realms/yoda).
OIDC_ISSUER=http://localhost:8080/realms/yoda
OIDC_CLIENT_ID=yoda-portal
STAFF_GROUP=/it-dev
# Applies only when a person is first created (first login); later changes do not alter existing people.
# dev: somchai (never set a common real username against the hospital Keycloak)
BOOTSTRAP_ADMINS=

# portal
PORTAL_PORT=3000
# dev proxy target; in containers set NUXT_CORE_URL at runtime
CORE_URL=http://localhost:4000
# Must match KEYCLOAK_PORT if overridden (browser-reachable Keycloak URL).
NUXT_PUBLIC_KEYCLOAK_URL=http://localhost:8080
NUXT_PUBLIC_KEYCLOAK_REALM=yoda
NUXT_PUBLIC_KEYCLOAK_CLIENT_ID=yoda-portal

# AI (keys come from the deploy environment; keep empty here)
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
# Optional base URL for an OpenAI-compatible provider
OPENAI_BASE_URL=
# provider:model, provider is anthropic or openai
AI_MODEL_DRAFT=anthropic:claude-opus-5-5
AI_MODEL_FAST=anthropic:claude-haiku-5-5
# unset = trigram-only search; e.g. openai:text-embedding-3-small (dimension fixed at 1024)
AI_EMBEDDING_MODEL=
AI_WORKERS=2

# object storage (matches docker-compose MinIO)
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=yoda
S3_ACCESS_KEY=yoda            # DEV ONLY
S3_SECRET_KEY=yoda-dev-minio  # DEV ONLY

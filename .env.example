# Placeholders / dev values only. Copy to .env (git-ignored). Never commit real secrets.
# Production secrets come from the deploy environment, not from files.

# dev compose host ports (bound to 127.0.0.1; override if taken)
POSTGRES_PORT=5432
S3_PORT=9000
S3_CONSOLE_PORT=9001
KEYCLOAK_PORT=8080
MAILPIT_SMTP_PORT=1025
MAILPIT_UI_PORT=8025

# prod compose host ports
CORE_PORT=4000

# core
PORT=4000
DATABASE_URL=postgres://yoda:yoda@localhost:5432/yoda
TEST_DATABASE_URL=postgres://yoda:yoda@localhost:5432/yoda_test
# Must match KEYCLOAK_PORT if you override it (e.g. http://localhost:18080/realms/yoda).
OIDC_ISSUER=http://localhost:8080/realms/yoda
OIDC_CLIENT_ID=yoda-portal
STAFF_GROUP=/it-dev
# Applies only when a person is first created (first login); later changes do not alter existing people.
# dev: somchai (never set a common real username against the hospital Keycloak)
BOOTSTRAP_ADMINS=

# portal
PORTAL_PORT=3000
# dev proxy target; in containers set NUXT_CORE_URL at runtime
CORE_URL=http://localhost:4000
# Must match KEYCLOAK_PORT if overridden (browser-reachable Keycloak URL).
NUXT_PUBLIC_KEYCLOAK_URL=http://localhost:8080
NUXT_PUBLIC_KEYCLOAK_REALM=yoda
NUXT_PUBLIC_KEYCLOAK_CLIENT_ID=yoda-portal
# Where the portal's Runners page links for setup docs (default: the README's Runners section)
# NUXT_PUBLIC_RUNNER_DOCS_URL=https://github.com/tantee/yoda#runners
# The LINE Official Account's add-friend link, shown when linking LINE (optional)
# NUXT_PUBLIC_LINE_ADD_FRIEND_URL=https://line.me/R/ti/p/@example

# AI (keys come from the deploy environment; keep empty here)
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
# Optional base URL for an OpenAI-compatible provider
OPENAI_BASE_URL=
# provider:model, provider is anthropic or openai
AI_MODEL_DRAFT=anthropic:claude-opus-5-5
AI_MODEL_FAST=anthropic:claude-haiku-5-5
# unset = trigram-only search; e.g. openai:text-embedding-3-small (dimension fixed at 1024)
AI_EMBEDDING_MODEL=
AI_WORKERS=2
# Most automatic task assignments one person gets per day (Asia/Bangkok); the rest wait for the PM
DAILY_TASK_CAP=8

# GitLab (all empty = GitLab features off; token and secret come from the deploy environment)
GITLAB_URL=
GITLAB_TOKEN=
# at least 16 characters
GITLAB_WEBHOOK_SECRET=
# base URL of the portal, used for links from GitLab issues
PORTAL_URL=http://localhost:3000

# runners (MCP); a runner's claim lasts this long without a heartbeat (at least 180;
# runners heartbeat every min(60 s, lease / 3))
RUNNER_LEASE_SECONDS=600
# serve the runner MCP endpoint at /mcp
MCP_ENABLED=true

# Email notifications (SMTP). Host and sender both set = email configured; an admin still enables it in
# Admin -> Notification channels. The password comes from the deploy environment only.
# Dev: docker-compose Mailpit accepts anything on localhost:1025 (web UI http://localhost:8025):
#   SMTP_HOST=localhost SMTP_PORT=1025 MAIL_FROM=yoda@example.org
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=

# LINE notifications (Messaging API, a LINE Official Account). Token and secret both set = LINE configured;
# an admin still enables it. Point the account's webhook at <core>/webhooks/line. Secrets come from the
# deploy environment only. Dev: `pnpm --filter @yoda/core fake-channels` (DEV ONLY) and
#   LINE_API_URL=http://127.0.0.1:4110 with any placeholder token and secret.
LINE_CHANNEL_ACCESS_TOKEN=
LINE_CHANNEL_SECRET=
LINE_API_URL=https://api.line.me
# Telegram notifications (Bot API). Token, username and webhook secret all set = Telegram configured.
# Register the webhook with setWebhook(url=<core>/webhooks/telegram, secret_token=TELEGRAM_WEBHOOK_SECRET).
# The webhook secret is 16-256 characters of A-Z, a-z, 0-9, _ and -. Dev: TELEGRAM_API_URL=http://127.0.0.1:4111
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
TELEGRAM_WEBHOOK_SECRET=
TELEGRAM_API_URL=https://api.telegram.org

# object storage (matches docker-compose RustFS)
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=yoda
# DEV ONLY (docker-compose RustFS)
S3_ACCESS_KEY=yoda
# DEV ONLY
S3_SECRET_KEY=yoda-dev-rustfs

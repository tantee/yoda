# Placeholders / dev values only. Never commit real secrets.
#
# ===== Production: nothing is required for a standard install =====
# install.sh (or deploy.sh) creates an empty .env (chmod 600) next to the compose files on the deploy host, and that
# is enough: the `init` service generates the Postgres password, the storage keys and the master key into the
# bootstrap volume, and the setup wizard (/setup) and System settings hold everything else. Do NOT copy this file
# there: its dev values would lock those settings (a value set in .env wins and shows "set by environment").
# Secrets live only in that .env and in CI/CD variables, never in the repository (docs/operations.md, section 3).
#
# ===== Advanced overrides (production, optional) =====
# Add a line to the deploy host's .env only to force a value from outside the UI (infra-as-code, or what the UI
# does not hold). Each one then shows locked in System settings. Examples (docs/operations.md, section 3):
#   DATABASE_URL=postgres://yoda:<password>@db.example.org:5432/yoda   external Postgres (bootstrap only)
#   S3_ENDPOINT=https://s3.example.org  S3_ACCESS_KEY=...  S3_SECRET_KEY=...   external S3 (bootstrap only)
#   POSTGRES_PASSWORD=...  S3_ACCESS_KEY=...  YODA_MASTER_KEY=...   keep an existing install's values (init copies them)
#   YODA_IMAGE_PREFIX=registry.example.org/group/yoda   when install.sh did not pin it in release.env
#   PORTAL_BIND / CORE_BIND / PORTAL_PORT / CORE_PORT   host addresses and ports (bootstrap only)
#   YODA_TRUSTED_PROXY_HOPS=2   a reverse proxy in front of the portal (bootstrap only)
#   COMPOSE_PROFILES=runner     the server runner (with YODA_RUNNER_* below)
#   OIDC_ISSUER=https://sso.example.org/realms/yoda          System settings → Sign-in
#   PORTAL_URL=https://portal.example.org                    System settings → General
#   SMTP_HOST / SMTP_PASSWORD / MAIL_FROM ...                System settings → Email
#   ANTHROPIC_API_KEY / OPENAI_API_KEY / AI_MODEL_* ...      System settings → AI
#   GITLAB_URL / GITLAB_TOKEN / GITLAB_WEBHOOK_SECRET        System settings → GitLab
#   LINE_* / TELEGRAM_*                                      System settings → LINE, Telegram
#   BACKUP_AT / BACKUP_KEEP_DAYS                             System settings → Backups
#   YODA_SETTINGS_IMPORT=false   do not copy env secrets into the database on start
#
# ===== Development (docker-compose.yml): cp .env.example .env =====
# Everything below is for a developer machine; core runs on the host with these values. The comments name the
# System settings page each value belongs to.

# dev compose host ports (bound to 127.0.0.1; override if taken)
POSTGRES_PORT=5432
S3_PORT=9000
S3_CONSOLE_PORT=9001
KEYCLOAK_PORT=8080
MAILPIT_SMTP_PORT=1025
MAILPIT_UI_PORT=8025

# prod compose only: Postgres credentials (the dev compose uses yoda/yoda; bootstrap only). Optional there: an
# empty POSTGRES_PASSWORD is generated into the bootstrap volume by the `init` service, and DATABASE_URL,
# S3_ACCESS_KEY, S3_SECRET_KEY and the master key likewise (docs/operations.md section 4a). A value set here wins.
POSTGRES_USER=yoda
POSTGRES_PASSWORD=
POSTGRES_DB=yoda

# prod compose host ports, published on 127.0.0.1 by default (a reverse proxy goes in front). Set
# PORTAL_BIND / CORE_BIND to another host address only when the proxy runs on another machine (firewall it).
CORE_PORT=4000
# CORE_BIND=127.0.0.1
# PORTAL_BIND=127.0.0.1

# prod compose images: ${YODA_IMAGE_PREFIX}/<core|portal|runner|backup>:${YODA_VERSION}. On a deploy host the
# prefix is the GitLab project's registry path (install.sh pins it in release.env with the version), and deploy.sh
# pins YODA_VERSION (the release tag) in release.env, not here. The prod compose has no default prefix (it never
# falls back to Docker Hub). A local prod-like run uses the dev value below and sets the version in the shell:
# YODA_VERSION=latest docker compose ... up --build -d
YODA_IMAGE_PREFIX=yoda
# YODA_VERSION=latest

# prod compose backup service: daily at BACKUP_AT (Asia/Bangkok), kept BACKUP_KEEP_DAYS days. System settings →
# Backups; leave them out of a deploy host's .env so the UI can change them (02:00 and 14 by default).
BACKUP_AT=02:00
BACKUP_KEEP_DAYS=14

# core
PORT=4000
DATABASE_URL=postgres://yoda:yoda@localhost:5432/yoda
TEST_DATABASE_URL=postgres://yoda:yoda@localhost:5432/yoda_test
# System settings → Sign-in. Must match KEYCLOAK_PORT if you override it (e.g. http://localhost:18080/realms/yoda).
OIDC_ISSUER=http://localhost:8080/realms/yoda
OIDC_CLIENT_ID=yoda-portal
# Optional: fetch signing keys here instead of ${OIDC_ISSUER}/protocol/openid-connect/certs (issuer check unchanged).
OIDC_JWKS_URL=
# true (default): the server migrates on start. The prod overlay sets false and runs the `migrate` service.
MIGRATE_ON_START=true
STAFF_GROUP=/it-dev
# Applies only when a person is first created (first login); later changes do not alter existing people.
# dev: somchai (never set a common real username against the hospital Keycloak)
BOOTSTRAP_ADMINS=

# portal
PORTAL_PORT=3000
# dev proxy target; in containers set NUXT_CORE_URL at runtime
CORE_URL=http://localhost:4000
# Deprecated overrides: the portal derives these from core's OIDC_ISSUER / OIDC_CLIENT_ID (GET /api/public-config).
# Set, they win (core logs loudly when they disagree with OIDC_ISSUER). Must match KEYCLOAK_PORT if overridden.
NUXT_PUBLIC_KEYCLOAK_URL=http://localhost:8080
NUXT_PUBLIC_KEYCLOAK_REALM=yoda
NUXT_PUBLIC_KEYCLOAK_CLIENT_ID=yoda-portal
# Where the portal's Runners page links for setup docs (default: the README's Runners section)
# NUXT_PUBLIC_RUNNER_DOCS_URL=https://github.com/tantee/yoda#runners
# The LINE Official Account's add-friend link, shown when linking LINE (optional)
# NUXT_PUBLIC_LINE_ADD_FRIEND_URL=https://line.me/R/ti/p/@example
# A line at the foot of the side menu, e.g. the department or hospital name (optional; empty: no line)
# NUXT_PUBLIC_ORG_LINE=IT Department

# AI: System settings → AI (keep the keys empty here)
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
# Optional base URL for an OpenAI-compatible provider
OPENAI_BASE_URL=
# provider:model, provider is anthropic or openai
AI_MODEL_DRAFT=anthropic:claude-opus-5-5
AI_MODEL_FAST=anthropic:claude-haiku-5-5
# unset = trigram-only search; e.g. openai:text-embedding-3-small (dimension fixed at 1024)
AI_EMBEDDING_MODEL=
AI_WORKERS=2
# Most automatic task assignments one person gets per day (Asia/Bangkok); the rest wait for the PM
DAILY_TASK_CAP=8

# GitLab: System settings → GitLab (all empty = GitLab features off; keep the token and secret empty here)
GITLAB_URL=
GITLAB_TOKEN=
# at least 16 characters
GITLAB_WEBHOOK_SECRET=
# base URL of the portal, used in links (System settings → General)
PORTAL_URL=http://localhost:3000

# runners (MCP); a runner's claim lasts this long without a heartbeat (at least 180;
# runners heartbeat every min(60 s, lease / 3))
RUNNER_LEASE_SECONDS=600
# serve the runner MCP endpoint at /mcp
MCP_ENABLED=true

# Email notifications (SMTP): System settings → Email. Host and sender both set = email configured; an admin
# still enables it in System settings → Notification channels.
# Dev: docker-compose Mailpit accepts anything on localhost:1025 (web UI http://localhost:8025):
#   SMTP_HOST=localhost SMTP_PORT=1025 MAIL_FROM=yoda@example.org
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=

# LINE notifications (Messaging API, a LINE Official Account): System settings → LINE. Token and secret both
# set = LINE configured; an admin still enables it. Webhook URL: https://portal.example.org/api/webhooks/line (the portal's /api
# proxy). Dev: `pnpm --filter @yoda/core fake-channels` (DEV ONLY) and
#   LINE_API_URL=http://127.0.0.1:4110 with any placeholder token and secret.
LINE_CHANNEL_ACCESS_TOKEN=
LINE_CHANNEL_SECRET=
LINE_API_URL=https://api.line.me
# Telegram notifications (Bot API): System settings → Telegram. Token, username and webhook secret all set =
# Telegram configured. The Register webhook button there points it at
# https://portal.example.org/api/webhooks/telegram (docs/operations.md section 9.3).
# The webhook secret is 16-256 characters of A-Z, a-z, 0-9, _ and -. Dev: TELEGRAM_API_URL=http://127.0.0.1:4111
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
TELEGRAM_WEBHOOK_SECRET=
TELEGRAM_API_URL=https://api.telegram.org

# object storage (matches docker-compose RustFS; bootstrap only, shown read-only in System settings → Storage)
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=yoda
# DEV ONLY (docker-compose RustFS)
S3_ACCESS_KEY=yoda
# DEV ONLY
S3_SECRET_KEY=yoda-dev-rustfs

# settings: the master key encrypts secrets saved in the admin settings (base64 of 32 bytes, e.g.
# `openssl rand -base64 32`), or YODA_MASTER_KEY_FILE names a file holding it. Empty = no secrets stored in the
# database (env secrets still work). Keep it in the recovery kit, never in the repository.
# YODA_SETTINGS_IMPORT=false: env secrets are not copied into the database on start.
YODA_MASTER_KEY=
YODA_MASTER_KEY_FILE=
YODA_SETTINGS_IMPORT=true
# prod compose sets this to the bootstrap volume's bootstrap.env (DATABASE_URL and the S3 keys when empty here).
YODA_BOOTSTRAP_FILE=
# DEV ONLY: setup counts as done without the setup wizard (the env-only dev flow). Never in production.
YODA_DEV_SKIP_SETUP=true
# Proxies in front of core whose X-Forwarded-For counts for the client address (rate limits, audit, alerts):
# 1 = the portal only; 2 = a reverse proxy in front of the portal. Never more than really there.
YODA_TRUSTED_PROXY_HOPS=1
# DEV ONLY: lets the admin settings Test buttons reach loopback (the dev fakes on 127.0.0.1). Never in production.
YODA_OUTBOUND_ALLOW_LOOPBACK=true

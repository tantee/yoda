{
  "key": "software-change",
  "name": {
    "th": "เปลี่ยนแปลงระบบ",
    "en": "Software change"
  },
  "steps": [
    {
      "key": "intake",
      "name": {
        "th": "รับเรื่อง",
        "en": "Intake"
      },
      "tasks": [
        {
          "key": "accept-intake",
          "type": "approval",
          "role": "PM",
          "title": {
            "th": "รับเรื่องเข้าระบบ",
            "en": "Accept the request"
          },
          "instructions": {
            "th": "พิจารณาและรับเรื่องที่ขอเปลี่ยนแปลงเข้าสู่กระบวนการ",
            "en": "Review the change request and accept it into the workflow"
          },
          "dependsOn": []
        }
      ]
    },
    {
      "key": "ba",
      "name": {
        "th": "วิเคราะห์ความต้องการ",
        "en": "Business analysis"
      },
      "tasks": [
        {
          "key": "draft-requirements",
          "type": "ai",
          "role": "BA",
          "title": {
            "th": "ร่างข้อกำหนด",
            "en": "Draft requirements"
          },
          "instructions": {
            "th": "ร่างข้อกำหนดจากรายละเอียดของงาน",
            "en": "Draft requirements from the work item description"
          },
          "dependsOn": [],
          "capability": "draft-text"
        },
        {
          "key": "answer-questions",
          "type": "human",
          "role": "REQUESTER",
          "title": {
            "th": "ตอบคำถามเพิ่มเติม",
            "en": "Answer the questions"
          },
          "instructions": {
            "th": "ตอบคำถามในร่างข้อกำหนด และแนบตัวอย่างเอกสารหรือข้อมูลที่เกี่ยวข้อง (ถ้ามี)",
            "en": "Answer the questions in the draft and attach any samples"
          },
          "dependsOn": [
            "draft-requirements"
          ]
        },
        {
          "key": "clarify-requirements",
          "type": "human",
          "role": "BA",
          "title": {
            "th": "ทำข้อกำหนดให้ชัดเจน",
            "en": "Clarify requirements"
          },
          "instructions": {
            "th": "ตรวจร่างข้อกำหนดและคำตอบจากผู้ขอ แล้วแก้ไขให้ครบถ้วน",
            "en": "Review the draft and the requester's answers, and complete it"
          },
          "dependsOn": [
            "draft-requirements",
            "answer-questions"
          ]
        },
        {
          "key": "approve-requirements",
          "type": "approval",
          "role": "BA",
          "title": {
            "th": "อนุมัติข้อกำหนด",
            "en": "Approve requirements"
          },
          "instructions": {
            "th": "อนุมัติข้อกำหนดฉบับสุดท้าย",
            "en": "Approve the final requirements"
          },
          "dependsOn": [
            "clarify-requirements"
          ]
        }
      ]
    },
    {
      "key": "sa",
      "name": {
        "th": "ออกแบบระบบ",
        "en": "System design"
      },
      "tasks": [
        {
          "key": "draft-design",
          "type": "ai",
          "role": "SA",
          "title": {
            "th": "ร่างแบบระบบ",
            "en": "Draft design"
          },
          "instructions": {
            "th": "ร่างแบบระบบจากข้อกำหนดที่อนุมัติแล้ว",
            "en": "Draft the system design from the approved requirements"
          },
          "dependsOn": [],
          "capability": "draft-text"
        },
        {
          "key": "approve-design",
          "type": "approval",
          "role": "SA",
          "title": {
            "th": "อนุมัติแบบระบบ",
            "en": "Approve design"
          },
          "instructions": {
            "th": "ตรวจและอนุมัติแบบระบบ",
            "en": "Review and approve the design"
          },
          "dependsOn": [
            "draft-design"
          ]
        }
      ]
    },
    {
      "key": "dev",
      "name": {
        "th": "พัฒนา",
        "en": "Development"
      },
      "tasks": [
        {
          "key": "implement",
          "type": "ai",
          "role": "DEV",
          "title": {
            "th": "พัฒนาโค้ด",
            "en": "Implement the change"
          },
          "instructions": {
            "th": "เขียนโค้ดตามข้อกำหนดและแบบที่อนุมัติแล้ว",
            "en": "Write the code according to the approved requirements and design"
          },
          "dependsOn": [],
          "capability": "code-change"
        },
        {
          "key": "draft-tests",
          "type": "ai",
          "role": "QC",
          "title": {
            "th": "ร่างกรณีทดสอบ",
            "en": "Draft test cases"
          },
          "instructions": {
            "th": "ร่างกรณีทดสอบจากข้อกำหนดที่อนุมัติแล้ว",
            "en": "Draft test cases from the approved requirements"
          },
          "dependsOn": [],
          "capability": "draft-text"
        },
        {
          "key": "review-code",
          "type": "review",
          "role": "DEV",
          "title": {
            "th": "ตรวจโค้ด",
            "en": "Review the code"
          },
          "instructions": {
            "th": "ตรวจโค้ดที่พัฒนา แล้วอนุมัติหรือส่งกลับให้แก้ไข",
            "en": "Review the implemented code, then approve it or request changes"
          },
          "dependsOn": [
            "implement"
          ]
        }
      ]
    },
    {
      "key": "qc",
      "name": {
        "th": "ทดสอบ",
        "en": "Quality check"
      },
      "tasks": [
        {
          "key": "verify",
          "type": "human",
          "role": "QC",
          "title": {
            "th": "ทดสอบระบบ",
            "en": "Verify the change"
          },
          "instructions": {
            "th": "ทดสอบตามกรณีทดสอบ และบันทึกผลที่พบ",
            "en": "Run the test cases and record the findings"
          },
          "dependsOn": []
        },
        {
          "key": "approve-release",
          "type": "approval",
          "role": "QC",
          "title": {
            "th": "อนุมัติการปล่อยใช้งาน",
            "en": "Approve the release"
          },
          "instructions": {
            "th": "ยืนยันว่าผลทดสอบผ่านและพร้อมปล่อยใช้งาน",
            "en": "Confirm the tests passed and the change is ready to release"
          },
          "dependsOn": [
            "verify"
          ]
        }
      ]
    },
    {
      "key": "close",
      "name": {
        "th": "ปิดงาน",
        "en": "Close"
      },
      "tasks": [
        {
          "key": "accept-delivery",
          "type": "approval",
          "role": "REQUESTER",
          "title": {
            "th": "ตรวจรับงาน",
            "en": "Accept the delivery"
          },
          "instructions": {
            "th": "ตรวจสอบว่างานที่ส่งมอบตรงกับที่ขอ แล้วยืนยันรับงานหรือขอให้แก้ไข",
            "en": "Check that the delivered work matches your request, then accept it or ask for changes"
          },
          "dependsOn": []
        },
        {
          "key": "close",
          "type": "approval",
          "role": "PM",
          "title": {
            "th": "ปิดงาน",
            "en": "Close the work item"
          },
          "instructions": {
            "th": "ตรวจว่างานครบถ้วนแล้วปิดงาน",
            "en": "Confirm everything is complete and close the work item"
          },
          "dependsOn": [
            "accept-delivery"
          ]
        }
      ]
    }
  ]
}

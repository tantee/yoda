  "version": "1.2.0",
  "license": "Apache-2.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite build --watch --mode development",
    "build": "tsx scripts/build.ts release",
    "build:e2e": "tsx scripts/build.ts e2e",
    "build:zip": "tsx scripts/build.ts release --zip",
    "check:dist": "tsx scripts/check-dist.ts dist",
    "typecheck": "vue-tsc --noEmit -p tsconfig.json",
    "e2e": "playwright test",
    "demo": "DEMO=1 playwright test e2e/demo.spec.ts"
  },
  "dependencies": {
    "@fontsource/ibm-plex-sans": "5.3.0",
    "@fontsource/ibm-plex-sans-thai": "5.3.0",
    "@mdi/font": "^7.4.47",
    "@yoda/shared": "workspace:*",
    "fflate": "0.8.2",
    "konva": "10.0.12",
    "vue": "^3.5.0",
    "vue-i18n": "^11.1.0",
    "vuetify": "^3.10.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@playwright/test": "1.57.0",
    "@types/chrome": "0.1.32",
    "@types/node": "22.20.5",
    "@vitejs/plugin-vue": "6.0.11",
    "fake-indexeddb": "6.2.5",
    "happy-dom": "20.0.11",
    "sass-embedded": "1.108.2",
    "tsx": "^4.20.0",
    "vite": "^7.1.0",
    "vite-plugin-vuetify": "^2.1.3",
    "vitest": "^3.2.0",
    "vue-tsc": "^3.0.0"

{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "lib": [
      "ES2023",
      "DOM",
      "DOM.Iterable",
      "WebWorker.ImportScripts"
    ],
    "types": [
      "chrome",
      "vite/client",
      "node"
    ],
    "jsx": "preserve",
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "module": "ESNext",
    "moduleResolution": "Bundler"
  },
  "include": [
    "src",
    "test",
    "scripts",
    "e2e",
    "vite.config.ts",
    "vitest.config.ts",
    "playwright.config.ts",
    "src/**/*.vue"
  ]
}
